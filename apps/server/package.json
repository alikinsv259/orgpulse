    "openai": "^7.15.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/koa": "3.0.2",
    "@types/koa__cors": "5.0.0",
    "@types/koa__router": "12.0.4",
    "@types/node": "^24.13.3",
    "@types/ws": "8.18.1",
